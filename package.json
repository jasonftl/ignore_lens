{
  "name": "ignore-lens",
  "displayName": "Ignore Lens",
  "description": "Highlights how many files each ignore line matches and flags those hitting zero for easy identification.",
  "version": "1.1.0",
  "publisher": "ignore-lens",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gitignore",
    "vscodeignore",
    "prettierignore",
    "eslintignore",
    "stylelintignore",
    "ignore",
    "patterns",
    "validation",
    "qualityoflife"
  ],
  "activationEvents": [
    "onLanguage:ignore"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ignore",
        "filenames": [
          ".gitignore",
          ".prettierignore",
          ".aiderignore",
          ".aiexclude",
          ".aiignore",
          ".alexignore",
          ".augmentignore",
          ".bazelignore",
          ".cfignore",
          ".clineignore",
          ".codeiumignore",
          ".cursorignore",
          ".deployignore",
          ".distignore",
          ".ebignore",
          ".eleventyignore",
          ".eslintignore",
          ".flooignore",
          ".geminiignore",
          ".helmignore",
          ".ignore",
          ".jpmignore",
          ".jshintignore",
          ".markdownlintignore",
          ".nodemonignore",
          ".nuxtignore",
          ".rgignore",
          ".slugignore",
          ".solhintignore",
          ".stylelintignore",
          ".stylintignore",
          ".swagger-codegen-ignore",
          ".tabnineignore",
          ".terraformignore",
          ".tokeignore",
          ".upignore",
          ".vercelignore",
          ".yarnignore",
          ".gcloudignore",
          ".npmignore",
          ".vscodeignore",
          ".bzrignore",
          ".chefignore",
          ".tfignore",
          ".dockerignore",
          ".cvsignore",
          ".p4ignore"
        ]
      }
    ],
    "colors": [
      {
        "id": "ignorelens.noMatchBackground",
        "description": "Background colour for patterns that do not match any files",
        "defaults": {
          "dark": "#4a1a1a40",
          "light": "#FFB6C140",
          "highContrast": "#FF000030"
        }
      },
      {
        "id": "ignorelens.noMatchForeground",
        "description": "Text colour for patterns that do not match any files",
        "defaults": {
          "dark": "#f14c4c",
          "light": "#cd3131",
          "highContrast": "#f14c4c"
        }
      },
      {
        "id": "ignorelens.matchCountForeground",
        "description": "Text colour for match count numbers",
        "defaults": {
          "dark": "#6A9955",
          "light": "#008000",
          "highContrast": "#6A9955"
        }
      },
      {
        "id": "ignorelens.negationForeground",
        "description": "Text colour for negation pattern counts",
        "defaults": {
          "dark": "#CCAA00",
          "light": "#996600",
          "highContrast": "#FFCC00"
        }
      },
      {
        "id": "ignorelens.staleMatchCountForeground",
        "description": "Text colour for stale/cached match counts (darker green)",
        "defaults": {
          "dark": "#3d5c30",
          "light": "#004d00",
          "highContrast": "#3d5c30"
        }
      },
      {
        "id": "ignorelens.staleNoMatchForeground",
        "description": "Text colour for stale/cached no-match patterns (darker red)",
        "defaults": {
          "dark": "#8b2020",
          "light": "#8b1a1a",
          "highContrast": "#8b2020"
        }
      },
      {
        "id": "ignorelens.staleNoMatchBackground",
        "description": "Background colour for stale/cached no-match patterns (darker red)",
        "defaults": {
          "dark": "#2a0a0a40",
          "light": "#8b6c6c40",
          "highContrast": "#4a000030"
        }
      },
      {
        "id": "ignorelens.staleNegationForeground",
        "description": "Text colour for stale/cached negation counts (darker yellow)",
        "defaults": {
          "dark": "#7a6600",
          "light": "#664400",
          "highContrast": "#7a6600"
        }
      }
    ],
    "configuration": {
      "title": "IgnoreLens",
      "properties": {
        "ignorelens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable IgnoreLens decorations"
        },
        "ignorelens.decorationStyle": {
          "type": "string",
          "enum": [
            "none",
            "background",
            "text",
            "both"
          ],
          "default": "text",
          "enumDescriptions": [
            "No decoration - patterns are not highlighted",
            "Background colour only",
            "Text colour only",
            "Both background and text colour"
          ],
          "description": "How to highlight redundant patterns (patterns that don't match any files)"
        },
        "ignorelens.scanDebounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce delay in milliseconds before rescanning after file changes"
        },
        "ignorelens.showMatchCount": {
          "type": "boolean",
          "default": true,
          "description": "Show match counts after each pattern"
        },
        "ignorelens.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the Output panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.11.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ignore": "^7.0.9",
    "minimatch": "^10.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonftl/ignore_lens"
  },
  "license": "MIT"
}
